{
  "openapi": "3.1.0",
  "info": {
    "title": "Achiote API",
    "version": "0.2.0",
    "description": "Achiote reconstructs nostalgic food and drink memories. The POST /v1/ask endpoint runs the full reconstruction workflow and streams progress as Server-Sent Events (SSE). The legacy POST /ask path is a backward-compatible alias.",
    "license": { "name": "BUSL-1.1", "url": "https://github.com/KyaniteLabs/Achiote/blob/main/LICENSE" }
  },
  "servers": [
    { "url": "https://achiote.kyanitelabs.tech", "description": "Hosted" },
    { "url": "http://localhost:3000", "description": "Local" }
  ],
  "tags": [
    { "name": "ask", "description": "Food and drink memory reconstruction." },
    { "name": "system", "description": "Health and readiness." },
    { "name": "mcp", "description": "Hosted MCP session." },
    { "name": "voice", "description": "Local speech transcription and synthesis." },
    { "name": "billing", "description": "Checkout, crypto orders, and issued API keys." },
    { "name": "telemetry", "description": "First-party analytics." },
    { "name": "docs", "description": "This specification." }
  ],
  "paths": {
    "/v1/ask": {
      "post": {
        "tags": ["ask"],
        "operationId": "askV1",
        "summary": "Reconstruct a food memory (streaming)",
        "description": "Runs the full reconstruction workflow and returns a text/event-stream of progress, tool calls, the synthesized answer (text events), an optional Memory Receipt (receipt event), and a terminal done event. Authenticate with an API key (Authorization: Bearer or x-api-key) for programmatic use, or x-demo-password for the anonymous demo when enabled.",
        "security": [
          { "bearerAuth": [] },
          { "apiKeyAuth": [] },
          { "demoPassword": [] }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/AskRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Server-Sent Events stream of the reconstruction.",
            "content": {
              "text/event-stream": {
                "schema": { "$ref": "#/components/schemas/AskSseStream" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "413": { "$ref": "#/components/responses/PayloadTooLarge" },
          "415": { "$ref": "#/components/responses/UnsupportedMediaType" },
          "429": { "$ref": "#/components/responses/RateLimited" }
        }
      }
    },
    "/ask": {
      "post": {
        "tags": ["ask"],
        "operationId": "askLegacy",
        "summary": "Reconstruct a food memory (legacy alias of /v1/ask)",
        "description": "Identical behavior to POST /v1/ask. Retained for the live site and existing clients.",
        "security": [
          { "bearerAuth": [] },
          { "apiKeyAuth": [] },
          { "demoPassword": [] }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/AskRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Server-Sent Events stream of the reconstruction.",
            "content": {
              "text/event-stream": {
                "schema": { "$ref": "#/components/schemas/AskSseStream" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "413": { "$ref": "#/components/responses/PayloadTooLarge" },
          "415": { "$ref": "#/components/responses/UnsupportedMediaType" },
          "429": { "$ref": "#/components/responses/RateLimited" }
        }
      }
    },
    "/health": {
      "get": {
        "tags": ["system"],
        "operationId": "health",
        "summary": "Liveness and provider status",
        "responses": {
          "200": {
            "description": "Service is up.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/HealthResponse" } }
            }
          }
        }
      }
    },
    "/ready": {
      "get": {
        "tags": ["system"],
        "operationId": "ready",
        "summary": "Readiness",
        "description": "Same body as /health. Returns 503 when a readiness check failed (status degraded).",
        "responses": {
          "200": { "description": "All readiness checks passed.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/HealthResponse" } } } },
          "503": { "$ref": "#/components/responses/ServiceUnavailable" }
        }
      }
    },
    "/.well-known/openai-apps-challenge": {
      "get": {
        "tags": ["system"],
        "operationId": "openaiAppsChallenge",
        "summary": "OpenAI apps domain-verification token",
        "description": "Returns the OPENAI_APPS_CHALLENGE_TOKEN as text/plain. 404 when the token is unset.",
        "responses": {
          "200": { "description": "The challenge token.", "content": { "text/plain": { "schema": { "type": "string" } } } },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/mcp": {
      "post": {
        "tags": ["mcp"],
        "operationId": "mcpPost",
        "summary": "Open or continue a hosted MCP session",
        "description": "Streamable HTTP MCP transport. A new session returns Mcp-Session-Id; later calls send that header back. Protocol errors use a JSON-RPC error body. The first request on a new session must be an initialize request: any other JSON-RPC method (for example tools/list) sent before initialize is rejected with JSON-RPC error code -32000, message \"Bad Request: initialize first\".",
        "parameters": [
          { "name": "Mcp-Session-Id", "in": "header", "required": false, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "JSON-RPC response, or an SSE stream when the client accepts text/event-stream." },
          "400": { "description": "Malformed session or JSON-RPC request, or a call made before initialize (JSON-RPC error -32000, \"Bad Request: initialize first\")." }
        }
      },
      "get": {
        "tags": ["mcp"],
        "operationId": "mcpGet",
        "summary": "Listen on an existing MCP session",
        "parameters": [
          { "name": "Mcp-Session-Id", "in": "header", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "SSE stream for the session." },
          "400": { "description": "Missing or unknown Mcp-Session-Id." }
        }
      },
      "delete": {
        "tags": ["mcp"],
        "operationId": "mcpDelete",
        "summary": "Close an MCP session",
        "parameters": [
          { "name": "Mcp-Session-Id", "in": "header", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Session closed." },
          "400": { "description": "Missing or unknown Mcp-Session-Id." }
        }
      }
    },
    "/voice/status": {
      "get": {
        "tags": ["voice"],
        "operationId": "voiceStatus",
        "summary": "Local speech readiness",
        "responses": {
          "200": { "description": "Speech subsystem status.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SpeechStatus" } } } }
        }
      }
    },
    "/voice/transcribe": {
      "post": {
        "tags": ["voice"],
        "operationId": "voiceTranscribe",
        "summary": "Transcribe a short audio clip",
        "security": [{ "bearerAuth": [] }, { "apiKeyAuth": [] }, { "demoPassword": [] }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SpeechTranscribeRequest" } } } },
        "responses": {
          "200": { "description": "Transcript.", "content": { "application/json": { "schema": { "type": "object", "properties": { "text": { "type": "string" } } } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "503": { "$ref": "#/components/responses/ServiceUnavailable" }
        }
      }
    },
    "/voice/synthesize": {
      "post": {
        "tags": ["voice"],
        "operationId": "voiceSynthesize",
        "summary": "Synthesize speech from text",
        "security": [{ "bearerAuth": [] }, { "apiKeyAuth": [] }, { "demoPassword": [] }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SpeechSynthesizeRequest" } } } },
        "responses": {
          "200": { "description": "Synthesized audio.", "content": { "application/json": { "schema": { "type": "object", "properties": { "audioBase64": { "type": "string" }, "mediaType": { "type": "string" } } } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "503": { "$ref": "#/components/responses/ServiceUnavailable" }
        }
      }
    },
    "/events": {
      "get": {
        "tags": ["telemetry"],
        "operationId": "eventsSummary",
        "summary": "Recent telemetry summary",
        "description": "Admin-gated telemetry summary. Without admin access this returns 404 { error: \"Not found\" } by design — the route is hidden, not challenged. Set ACHIOTE_EVENTS_ADMIN_TOKEN and send it as a bearer token to read the summary.",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "Telemetry counters, breakdowns and quality report (admin only)." },
          "404": { "description": "No admin access: ACHIOTE_EVENTS_ADMIN_TOKEN is unset or the bearer token does not match (hidden by design, not a 401 challenge)." }
        }
      },
      "post": {
        "tags": ["telemetry"],
        "operationId": "eventsCapture",
        "summary": "Capture a first-party telemetry event",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/TelemetryEvent" } } } },
        "responses": {
          "202": { "description": "Accepted." },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "413": { "$ref": "#/components/responses/PayloadTooLarge" }
        }
      }
    },
    "/openapi.json": {
      "get": {
        "tags": ["docs"],
        "operationId": "openapiJson",
        "summary": "This specification, as JSON",
        "responses": { "200": { "description": "The OpenAPI document.", "content": { "application/json": { "schema": { "type": "object" } } } } }
      }
    },
    "/openapi.yaml": {
      "get": {
        "tags": ["docs"],
        "operationId": "openapiYaml",
        "summary": "This specification, as YAML",
        "responses": { "200": { "description": "The OpenAPI document.", "content": { "application/yaml": { "schema": { "type": "string" } } } } }
      }
    },
    "/billing/checkout": {
      "post": {
        "tags": ["billing"],
        "operationId": "billingCheckout",
        "summary": "Start a Stripe subscription checkout",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CheckoutRequest" } } } },
        "responses": {
          "200": { "description": "Stripe Checkout URL.", "content": { "application/json": { "schema": { "type": "object", "required": ["url"], "properties": { "url": { "type": "string" } } } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "503": { "$ref": "#/components/responses/ServiceUnavailable" }
        }
      }
    },
    "/billing/crypto-order": {
      "post": {
        "tags": ["billing"],
        "operationId": "billingCryptoOrder",
        "summary": "Create a Solana Pay order",
        "description": "tier personal or family is a subscription; memory-pack or family-sprint is a one-time payment. asset defaults to USDC.",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CryptoOrderRequest" } } } },
        "responses": {
          "200": { "description": "Pending order.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CryptoOrder" } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "503": { "$ref": "#/components/responses/ServiceUnavailable" }
        }
      }
    },
    "/billing/crypto-status": {
      "get": {
        "tags": ["billing"],
        "operationId": "billingCryptoStatus",
        "summary": "Poll a crypto order",
        "parameters": [
          { "name": "ref", "in": "query", "required": true, "schema": { "type": "string", "pattern": "^[23456789ABCDEFGHJKLMNPQRSTUVWXYZ]{8}$" } }
        ],
        "responses": {
          "200": { "description": "Order status. sessionId is present only when status is paid.", "content": { "application/json": { "schema": { "type": "object", "properties": { "status": { "type": "string" }, "sessionId": { "type": "string" } } } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "503": { "$ref": "#/components/responses/ServiceUnavailable" }
        }
      }
    },
    "/billing/portal": {
      "post": {
        "tags": ["billing"],
        "operationId": "billingPortal",
        "summary": "Open the Stripe customer portal",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PortalRequest" } } } },
        "responses": {
          "200": { "description": "Portal URL.", "content": { "application/json": { "schema": { "type": "object", "required": ["url"], "properties": { "url": { "type": "string" } } } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "503": { "$ref": "#/components/responses/ServiceUnavailable" }
        }
      }
    },
    "/billing/webhook": {
      "post": {
        "tags": ["billing"],
        "operationId": "billingWebhook",
        "summary": "Stripe webhook",
        "description": "Requires a valid Stripe-Signature header. Not a public API.",
        "parameters": [
          { "name": "Stripe-Signature", "in": "header", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Event accepted.", "content": { "application/json": { "schema": { "type": "object", "properties": { "received": { "type": "boolean" } } } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "503": { "$ref": "#/components/responses/ServiceUnavailable" }
        }
      }
    },
    "/billing/session": {
      "get": {
        "tags": ["billing"],
        "operationId": "billingSession",
        "summary": "Redeem a checkout session for its API key",
        "description": "The key is returned once. Stripe sessions also require the checkout email.",
        "parameters": [
          { "name": "session_id", "in": "query", "required": true, "schema": { "type": "string" } },
          { "name": "email", "in": "query", "required": false, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Completed session and its one-time API key." },
          "202": { "description": "Payment still pending." },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "503": { "$ref": "#/components/responses/ServiceUnavailable" }
        }
      }
    },
    "/billing/success": {
      "get": {
        "tags": ["billing"],
        "operationId": "billingSuccess",
        "summary": "Post-checkout page",
        "responses": {
          "200": { "description": "The billing success page.", "content": { "text/html": { "schema": { "type": "string" } } } },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": { "type": "http", "scheme": "bearer", "description": "API key from `npm run keygen`, sent as Authorization: Bearer <key>." },
      "apiKeyAuth": { "type": "apiKey", "in": "header", "name": "x-api-key", "description": "API key from `npm run keygen`." },
      "demoPassword": { "type": "apiKey", "in": "header", "name": "x-demo-password", "description": "Anonymous demo password; only valid when the server enables the demo path." }
    },
    "schemas": {
      "AskRequest": {
        "type": "object",
        "description": "At least one of `message` or `images` is required.",
        "properties": {
          "message": { "type": "string", "maxLength": 6000, "description": "The food or drink memory to reconstruct." },
          "history": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "type": "object",
              "properties": {
                "role": { "type": "string", "enum": ["user", "assistant"] },
                "content": { "type": "string" }
              },
              "required": ["role", "content"]
            },
            "description": "Prior conversation turns, oldest first."
          },
          "images": {
            "type": "array",
            "maxItems": 4,
            "items": { "type": "string", "description": "data:image/...;base64,... data URI (jpeg, png, gif, or webp)." },
            "description": "Optional images of the dish or packaging."
          },
          "consent": { "$ref": "#/components/schemas/DataConsent" }
        }
      },
      "DataConsent": {
        "type": "object",
        "description": "Per-request consent flags; all default to false.",
        "properties": {
          "analytics": { "type": "boolean" },
          "qualitySignals": { "type": "boolean" },
          "savedMemory": { "type": "boolean" },
          "familyConfirmation": { "type": "boolean" },
          "publicContribution": { "type": "boolean" }
        }
      },
      "AskSseStream": {
        "type": "string",
        "description": "A text/event-stream. Each frame is `event: <name>\\ndata: <json>\\n\\n`. Event names and the JSON shape of their data:\n- status: {stage, ...} progress markers (routing, model, calling_tools, thinking, case_file_compacted, deterministic_recovery, ...).\n- tool_call: {name, input} a workflow tool is about to run.\n- tool_result: {name, result} a workflow tool returned.\n- text: a JSON string — the synthesized answer prose (may be emitted once).\n- receipt: a MemoryReceipt object.\n- done: {guarded?} terminal event; `guarded` is set when a deterministic guard produced the answer.\n- error: {message, code?} an error occurred."
      },
      "MemoryReceipt": {
        "type": "object",
        "required": ["title", "createdAt", "status", "evidence", "hypotheses", "nextBestQuestions", "assistantSummary"],
        "properties": {
          "title": { "type": "string", "const": "Achiote Memory Receipt" },
          "createdAt": { "type": "string" },
          "status": { "type": "string", "enum": ["needs_more_clues", "first_test_ready", "recipe_handoff_ready"] },
          "evidence": {
            "type": "object",
            "properties": {
              "userSaid": { "type": "array", "items": { "type": "string" } },
              "ruledOut": { "type": "array", "items": { "type": "string" } },
              "inferred": { "type": "array", "items": { "type": "string" } },
              "researched": { "type": "array", "items": { "type": "string" } },
              "unknown": { "type": "array", "items": { "type": "string" } }
            }
          },
          "hypotheses": { "type": "array", "items": { "type": "object" } },
          "nextBestQuestions": { "type": "array", "items": { "type": "string" } },
          "firstTinyTasteTest": {
            "type": "object",
            "properties": {
              "title": { "type": "string" },
              "cue": { "type": "string" },
              "estimatedTime": { "type": "string" }
            }
          },
          "assistantSummary": { "type": "string" }
        }
      },
      "HealthResponse": {
        "type": "object",
        "properties": {
          "status": { "type": "string" },
          "version": { "type": "string" },
          "authEnabled": { "type": "boolean" },
          "billingEnabled": { "type": "boolean" },
          "cryptoEnabled": { "type": "boolean" },
          "readiness": { "$ref": "#/components/schemas/Readiness" },
          "uptime": { "type": "number" },
          "provider": { "type": "object" }
        }
      },
      "Readiness": {
        "type": "object",
        "required": ["ready", "status", "checks"],
        "properties": {
          "ready": { "type": "boolean" },
          "status": { "type": "string", "enum": ["ok", "degraded"] },
          "checks": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "ok", "message"],
              "properties": {
                "name": { "type": "string" },
                "ok": { "type": "boolean" },
                "message": { "type": "string" }
              }
            }
          }
        }
      },
      "SpeechStatus": {
        "type": "object",
        "required": ["enabled", "stt", "tts"],
        "properties": {
          "enabled": { "type": "boolean" },
          "stt": { "type": "object", "required": ["ready"], "properties": { "ready": { "type": "boolean" }, "command": { "type": "string" } } },
          "tts": { "type": "object", "required": ["ready"], "properties": { "ready": { "type": "boolean" }, "command": { "type": "string" } } }
        }
      },
      "SpeechTranscribeRequest": {
        "type": "object",
        "required": ["audioBase64", "mediaType"],
        "properties": {
          "audioBase64": { "type": "string" },
          "mediaType": { "type": "string", "description": "audio/wav, audio/mpeg, audio/webm, audio/ogg, or audio/mp4." },
          "language": { "type": "string" }
        }
      },
      "SpeechSynthesizeRequest": {
        "type": "object",
        "required": ["text"],
        "properties": {
          "text": { "type": "string" },
          "voice": { "type": "string" },
          "language": { "type": "string" }
        }
      },
      "CheckoutRequest": {
        "type": "object",
        "required": ["tier"],
        "properties": {
          "tier": { "type": "string", "enum": ["personal", "family"] },
          "mode": { "type": "string", "enum": ["subscription"] }
        }
      },
      "CryptoOrderRequest": {
        "type": "object",
        "required": ["tier"],
        "properties": {
          "tier": { "type": "string", "enum": ["personal", "family", "memory-pack", "family-sprint"] },
          "asset": { "type": "string", "enum": ["USDC", "SOL"] }
        }
      },
      "CryptoOrder": {
        "type": "object",
        "required": ["ref", "asset", "address", "amount", "uri", "expiresAtMs"],
        "properties": {
          "ref": { "type": "string" },
          "asset": { "type": "string" },
          "address": { "type": "string" },
          "amount": { "type": "string" },
          "uri": { "type": "string" },
          "expiresAtMs": { "type": "number" }
        }
      },
      "PortalRequest": {
        "type": "object",
        "required": ["keyId"],
        "properties": { "keyId": { "type": "string" } }
      },
      "TelemetryEvent": {
        "type": "object",
        "required": ["event"],
        "properties": {
          "event": { "type": "string", "maxLength": 64, "pattern": "^[a-z0-9_:-]+$" },
          "properties": { "type": "object", "additionalProperties": { "type": "string", "maxLength": 120 } }
        }
      },
      "Error": {
        "type": "object",
        "properties": { "error": { "type": "string" } }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Invalid JSON, missing message/images, or invalid images.",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
      },
      "Unauthorized": {
        "description": "Missing or invalid API key / demo password, or anonymous access disabled.",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
      },
      "PayloadTooLarge": {
        "description": "Request body exceeds the size limit.",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
      },
      "UnsupportedMediaType": {
        "description": "Content-Type must be application/json.",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
      },
      "RateLimited": {
        "description": "Rate limit exceeded; upgrade the plan for more reconstructions.",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
      },
      "ServiceUnavailable": {
        "description": "A required subsystem (billing, crypto, or speech) is not configured, or readiness checks failed.",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
      },
      "NotFound": {
        "description": "The requested resource does not exist.",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
      },
