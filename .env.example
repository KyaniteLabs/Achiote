# Server port (default: 3000)
PORT=3000

# Authentication
ACHIOTE_AUTH_ENABLED=true
# JSON array of API key objects. Required when AUTH_ENABLED=true.
# Tiers: free, personal, pro, family, business (legacy alias), enterprise
# ACHIOTE_API_KEYS=[{"keyId":"ak_your_key_id","keyHash":"sha256:your_key_hash","tier":"pro","name":"admin","createdAt":"2026-04-21T00:00:00.000Z"}]

# Dangerous local-demo-only switch: allow /ask without API keys when auth is disabled
ACHIOTE_ALLOW_ANON_ASK=false
# Optional local/preview demo override for anonymous web reconstructions.
# Leave unset in public production to use the free-tier default.
# ACHIOTE_ANON_WEB_RECONSTRUCTIONS=25

# CORS — comma-separated origins (default: http://localhost:3000)
ACHIOTE_ALLOWED_ORIGINS=http://localhost:3000

# Trust X-Forwarded-For header for rate limiting behind a reverse proxy
ACHIOTE_TRUST_PROXY=false
# Comma-separated proxy remote addresses allowed to supply X-Forwarded-For when trust proxy is true
ACHIOTE_TRUSTED_PROXY_IPS=127.0.0.1,::1

# Persistent rate limiting database (omit for in-memory, which resets on restart)
# ACHIOTE_RATE_LIMIT_DB=/path/to/rate-limit.db

# Research cache database (omit for default ~/.cache/achiote/culture-cache.db)
# ACHIOTE_CACHE_PATH=/path/to/cache.db

# /ask model provider
# anthropic: Anthropic Messages API and Anthropic-compatible endpoints (Anthropic, GLM/Z.ai)
# openai: OpenAI Chat Completions-compatible endpoints (OpenAI, LM Studio)
ACHIOTE_ASK_PROVIDER=anthropic
# Anthropic defaults
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_AUTH_TOKEN=...
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# ANTHROPIC_DEFAULT_SONNET_MODEL=claude-sonnet-4-5-20250929
# Anthropic/OpenAI shared override; use only when intentionally overriding provider-specific model env
# ACHIOTE_ASK_MODEL=

# OpenAI-compatible provider defaults
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
#
# OpenRouter uses the OpenAI-compatible provider path, but every model can differ.
# Free models are rate-limit sensitive; use long timeouts and let Achiote check
# OpenRouter catalog metadata before assuming native tool support.
# ACHIOTE_ASK_PROVIDER=openai
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_API_KEY=sk-or-...
# OPENAI_MODEL=openai/gpt-oss-20b:free
# OPENAI_TIMEOUT_MS=240000

# ── Local inference via Tailscale (zero cost, for demo) ─────────────────────
# Use LOCAL_INFERENCE_* to point at a home inference server over Tailscale.
# The VPS docker-compose includes extra_hosts: host.docker.internal:host-gateway.
# See deploy/hostinger-vps/LOCAL_INFERENCE_REPORT.md for model compatibility.
#
# EXECUTION-TESTED MODELS (April 2026, with retries):
#   qwen3.6-35b-a3b  — 🏆 BEST (MoE, 0 retries, ~6s/turn)
#   qwen3.5-0.8b     — ✅ Excellent fallback (0 retries, ~6s/turn)
#   qwen3.6-27b      — ✅ Works (3 retries, ~25s/turn)
#   qwen3.5-4b       — ✅ Works (4 retries, ~30s/turn)
#   qwen3.5-2b       — ✅ Works (~10s/turn)
#   qwen3.5-9b       — ✅ Works with warmup (~10s/turn)
#   lfm2.5-1.2b      — ⚠️ Skips final cue step
#
# NOTE: Server runs 7 models simultaneously. Use retries with backoff.
#       Wait 10s+ between model switches. Warmup calls help.
#
# ACHIOTE_ASK_PROVIDER=local
# ACHIOTE_ASK_MODEL=qwen3.6-35b-a3b    # or qwen3.5-0.8b for fallback
# LOCAL_INFERENCE_ENDPOINT_STYLE=openai-chat-completions
# Supported LM Studio endpoint styles:
# - openai-chat-completions: /v1/chat/completions, current default runtime path
# - anthropic-messages: /v1/messages, Claude/Anthropic-compatible runtime path
# - openai-responses: /v1/responses, profiler/diagnostic only until Achiote has a Responses adapter
# - native-chat: /api/v1/chat, profiler/diagnostic only until Achiote has a native LM Studio adapter
# LOCAL_INFERENCE_BASE_URL=http://100.66.225.85:1234/v1   # Tailscale IP; omit /v1 when using anthropic-messages
# LOCAL_INFERENCE_MODEL=qwen3.6-35b-a3b
# LOCAL_INFERENCE_API_KEY=
# LOCAL_INFERENCE_TIMEOUT_MS=120000
# ────────────────────────────────────────────────────────────────────────────

# GLM / Z.ai (Zhipu AI)
# ACHIOTE_ASK_PROVIDER=glm
# GLM_API_KEY=your_glm_api_key
# GLM Coding Plan newer models generally use Z.ai's Anthropic-compatible endpoint.
# ACHIOTE_ASK_MODEL=GLM-5.1
# GLM_ENDPOINT_STYLE=anthropic-coding
# GLM_BASE_URL=https://api.z.ai/api/anthropic
# Older GLM 4.5 Air/Flash models default to OpenAI-compatible coding-plan routing
# unless GLM_ENDPOINT_STYLE is explicitly set for an experiment.
# ACHIOTE_ASK_MODEL=GLM-4.5-Air
# GLM_ENDPOINT_STYLE=openai-coding
# GLM_OPENAI_BASE_URL=https://api.z.ai/api/coding/paas/v4
# GLM_MODEL=GLM-4.5-Flash

# Provider request timeout in milliseconds
# ANTHROPIC_TIMEOUT_MS=120000
# OPENAI_TIMEOUT_MS=180000

# Web search (Serper.dev) — free tier available at https://serper.dev
# SERPER_API_KEY=your_serper_api_key

# Demo password for simple auth (share with testers)
# ACHIOTE_DEMO_PASSWORD=your_demo_password

# ── Optional local OSS speech ───────────────────────────────────────────────
# Disabled by default. These settings never call a hosted speech API.
# Recommended STT: whisper.cpp with a multilingual model for accents,
# code-switching, and immigrant-family food memories.
# ACHIOTE_STT_PROVIDER=whispercpp
# ACHIOTE_WHISPER_CPP_BINARY=/usr/local/bin/whisper-cli
# ACHIOTE_WHISPER_CPP_MODEL=/models/ggml-large-v3-turbo.bin
# ACHIOTE_STT_LANGUAGE=auto
# ACHIOTE_STT_LANGUAGES=auto,es,hi,zh,ar,fr,pt,tl

# Recommended TTS: Kokoro-82M through a local command adapter.
# Command must be a JSON argv array and include {text} and {output}.
# Optional placeholders: {voice}, {language}
# ACHIOTE_TTS_PROVIDER=kokoro
# ACHIOTE_KOKORO_COMMAND=["python","/opt/kokoro/speak.py","--text","{text}","--output","{output}","--voice","{voice}","--language","{language}"]
# ACHIOTE_KOKORO_VOICE=af_heart
# ACHIOTE_KOKORO_VOICES=[{"id":"af_heart","label":"Warm English","language":"en"}]
# ACHIOTE_TTS_MEDIA_TYPE=audio/wav

# ── Stripe Billing ───────────────────────────────────────────────────────────
# Required for subscription and credit-pack checkout
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PERSONAL_PRICE_ID=price_...
# STRIPE_PERSONAL_ANNUAL_PRICE_ID=price_...
# STRIPE_FAMILY_PRICE_ID=price_...
# STRIPE_MEMORY_PACK_PRICE_ID=price_...
# STRIPE_FAMILY_SPRINT_PRICE_ID=price_...
# Backwards-compatible alias for older deployments. Prefer STRIPE_MEMORY_PACK_PRICE_ID.
# STRIPE_CREDIT_PACK_PRICE_ID=price_...
# Base URL for checkout success/cancel redirects (default: http://localhost:3000)
# STRIPE_BASE_URL=https://achiote.kyanitelabs.tech

# Persistent billing database (default: ~/.cache/achiote/billing.db)
# ACHIOTE_BILLING_DB=/path/to/billing.db
