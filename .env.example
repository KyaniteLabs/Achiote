# Server port (default: 3000)
PORT=3000

# Authentication
ACHIOTE_AUTH_ENABLED=true
# JSON array of API key objects. Required when AUTH_ENABLED=true.
# Tiers: free, pro, business, enterprise
# ACHIOTE_API_KEYS=[{"keyId":"ak_your_key_id","keyHash":"sha256:your_key_hash","tier":"pro","name":"admin","createdAt":"2026-04-21T00:00:00.000Z"}]

# Dangerous local-demo-only switch: allow /ask without API keys when auth is disabled
ACHIOTE_ALLOW_ANON_ASK=false

# CORS — comma-separated origins (default: http://localhost:3000)
ACHIOTE_ALLOWED_ORIGINS=http://localhost:3000

# Trust X-Forwarded-For header for rate limiting behind a reverse proxy
ACHIOTE_TRUST_PROXY=false
# Comma-separated proxy remote addresses allowed to supply X-Forwarded-For when trust proxy is true
ACHIOTE_TRUSTED_PROXY_IPS=127.0.0.1,::1

# Persistent rate limiting database (omit for in-memory, which resets on restart)
# ACHIOTE_RATE_LIMIT_DB=/path/to/rate-limit.db

# Research cache database (omit for default ~/.cache/achiote/culture-cache.db)
# ACHIOTE_CACHE_PATH=/path/to/cache.db

# /ask model provider
# anthropic: Anthropic Messages API and Anthropic-compatible endpoints
# openai: OpenAI Chat Completions-compatible endpoints, including LM Studio
ACHIOTE_ASK_PROVIDER=anthropic
# Anthropic defaults
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_AUTH_TOKEN=...
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# ANTHROPIC_DEFAULT_SONNET_MODEL=claude-sonnet-4-5-20250929
# Anthropic/OpenAI shared override; use only when intentionally overriding provider-specific model env
# ACHIOTE_ASK_MODEL=

# OpenAI-compatible provider defaults
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
# Local LM Studio example
# ACHIOTE_ASK_PROVIDER=openai
# OPENAI_BASE_URL=http://127.0.0.1:1234/v1
# OPENAI_MODEL=qwen3.5-0.8b

# Provider request timeout in milliseconds
# ANTHROPIC_TIMEOUT_MS=120000
# OPENAI_TIMEOUT_MS=180000
