{
  "name": "achiote",
  "version": "0.2.0",
  "description": "Nostalgic food memory reconstruction MCP server — recreates childhood dishes using ingredients available where you are",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint && npm run coverage:guard && npm run build && npm run validate:citations && npm test",
    "check:compat": "npm run typecheck && npm run build && npm test",
    "validate:citations": "node scripts/validate-citations.mjs --tolerant",
    "pack:check": "npm run check && npm run package:smoke && npm pack --dry-run",
    "package:smoke": "node scripts/package-smoke.mjs",
    "prepack": "npm run build",
    "keygen": "node scripts/generate-api-key.mjs",
    "docker:smoke": "node scripts/docker-smoke.mjs",
    "lint": "node scripts/static-checks.mjs",
    "coverage:guard": "node scripts/coverage-threshold.mjs",
    "live:ask": "node scripts/live-ask-smoke.mjs",
    "preview:smoke": "node scripts/preview-ask-smoke.mjs",
    "canary:local": "npm run build && node scripts/local-canary-qa.mjs",
    "local:profile": "npm run build && node scripts/local-inference-profiler.mjs",
    "telemetry:models": "npm run build && node scripts/model-telemetry-report.mjs",
    "knowledge:canary": "node scripts/knowledge-gap-canary.mjs",
    "torture:fake": "npm run build && node scripts/torture-smoke.mjs",
    "viability:smoke": "node scripts/viability-transcript-smoke.mjs",
    "reference:seeds": "npm run build && node scripts/reference-seed-operator.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.91.1",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "better-sqlite3": "^11.9.0",
    "stripe": "^22.0.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.13.0",
    "@types/stripe": "^8.0.416",
    "typescript": "^5.7.0",
    "vite": "^8.0.9",
    "vitest": "^3.0.0"
  },
  "license": "BUSL-1.1",
  "types": "dist/index.d.ts",
  "bin": {
    "achiote": "bin/achiote.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "bin/",
    "dist/",
    "skill/",
    "scripts/",
    "!scripts/weak-cloud-overnight.mjs",
    "docs/ARCHITECTURE.md",
    "docs/AI_SEARCH_SUBMISSION_RUNBOOK.md",
    "docs/LAUNCH_RUNBOOK.md",
    "docs/ROADMAP.md",
    "docs/SELF_HOSTED_RUNNER.md",
    "docs/landing/about.html",
    "docs/landing/ai-search.html",
    "docs/landing/app.html",
    "docs/landing/product-app.js",
    "docs/landing/app.js",
    "docs/landing/blog.html",
    "docs/landing/billing-success.html",
    "docs/landing/changelog.html",
    "docs/landing/compare.html",
    "docs/landing/fonts/",
    "docs/landing/hero-image.jpg",
    "docs/landing/images/",
    "docs/landing/index.html",
    "docs/landing/index.js",
    "docs/landing/llms.txt",
    "docs/landing/manifest.json",
    "docs/landing/og-image.jpg",
    "docs/landing/pricing.html",
    "docs/landing/privacy.html",
    "docs/landing/receipt.html",
    "docs/landing/receipt.js",
    "docs/landing/robots.txt",
    "docs/landing/roadmap.html",
    "docs/landing/safety.html",
    "docs/landing/sample-reconstruction-artifact.md",
    "docs/landing/sitemap.xml",
    "docs/landing/status.html",
    "docs/landing/support.html",
    "docs/landing/terms.html",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KyaniteLabs/Achiote.git"
  },
  "bugs": {
    "url": "https://github.com/KyaniteLabs/Achiote/issues"
  },
  "homepage": "https://github.com/KyaniteLabs/Achiote#readme",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "culinary",
    "recipes",
    "food",
    "nostalgia"
  ]
}
