{
  "name": "achiote",
  "version": "0.2.0",
  "description": "Nostalgic food memory reconstruction MCP server — recreates childhood dishes using ingredients available where you are",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run build && npm run validate:citations && npm test",
    "validate:citations": "node scripts/validate-citations.mjs",
    "pack:check": "npm run check && npm run package:smoke && npm pack --dry-run",
    "package:smoke": "node scripts/package-smoke.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.71",
    "@anthropic-ai/sdk": "^0.90.0",
    "@mastra/core": "^1.25.0",
    "@mastra/mcp": "^1.5.0",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "ai": "^6.0.168",
    "better-sqlite3": "^11.9.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.13.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "typescript": "^5.7.0",
    "vite": "^8.0.9",
    "vitest": "^3.0.0"
  },
  "license": "MIT",
  "types": "dist/index.d.ts",
  "bin": {
    "achiote": "bin/achiote.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "bin/",
    "dist/",
    "skill/",
    "docs/ARCHITECTURE.md",
    "docs/ROADMAP.md",
    "docs/SELF_HOSTED_RUNNER.md",
    "docs/landing/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Pastorsimon1798/achiote.git"
  },
  "bugs": {
    "url": "https://github.com/Pastorsimon1798/achiote/issues"
  },
  "homepage": "https://github.com/Pastorsimon1798/achiote#readme",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "culinary",
    "recipes",
    "food",
    "nostalgia"
  ]
}
