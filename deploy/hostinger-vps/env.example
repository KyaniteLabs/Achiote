# Copy this file to env.hostinger on the VPS and fill real values.
# Do not commit env.hostinger.

# ── Public DNS name that points at the VPS, without scheme.
ACHIOTE_PUBLIC_HOST=achiote.kyanitelabs.tech

# ── Provider: glm (cloud) or local (home inference via Tailscale) ──
# Default: glm (Z.AI cloud)
ACHIOTE_ASK_PROVIDER=glm
ACHIOTE_ASK_MODEL=GLM-5.1

# Cloud provider (GLM/Z.AI)
GLM_API_KEY=your-glm-api-key
GLM_ENDPOINT_STYLE=anthropic-coding
GLM_BASE_URL=https://api.z.ai/api/anthropic
# For older GLM 4.5 endpoint experiments only:
# GLM 4.5 Air/Flash defaults to openai-coding when no style is set.
# GLM_ENDPOINT_STYLE=openai-coding
# GLM_OPENAI_BASE_URL=https://api.z.ai/api/coding/paas/v4
GLM_TIMEOUT_MS=180000

# ── Alternative: OpenRouter weak/free cloud models ──
# Set ACHIOTE_ASK_PROVIDER=openai and use long timeouts. Achiote treats
# :free models as rate-limit sensitive and checks catalog metadata before
# assuming tool support.
# ACHIOTE_ASK_PROVIDER=openai
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_API_KEY=your-openrouter-key
# OPENAI_MODEL=openai/gpt-oss-20b:free
# OPENAI_TIMEOUT_MS=240000

# ── Alternative: home inference server via Tailscale ──
# Uncomment these and set ACHIOTE_ASK_PROVIDER=local to use local inference.
# This is the same pattern used by Declutter and DialectOS.
#
# ACHIOTE_ASK_PROVIDER=local
# ACHIOTE_ASK_MODEL=your-loaded-model-name
# LOCAL_INFERENCE_ENDPOINT_STYLE=openai-chat-completions
# LOCAL_INFERENCE_BASE_URL=http://host.docker.internal:1234/v1
# LOCAL_INFERENCE_MODEL=your-loaded-model-name
# LOCAL_INFERENCE_API_KEY=
# LOCAL_INFERENCE_TIMEOUT_MS=180000
#
# Or use a Tailscale IP directly (if your inference server is on a different
# machine on the same Tailscale network):
# LOCAL_INFERENCE_BASE_URL=http://100.x.x.x:1234/v1
#
# To test LM Studio's Anthropic-compatible route instead:
# LOCAL_INFERENCE_ENDPOINT_STYLE=anthropic-messages
# LOCAL_INFERENCE_BASE_URL=http://100.x.x.x:1234

# ── Required service config ──
SERPER_API_KEY=your-serper-api-key

# ── Stripe (for paid deployments) ──
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_BASE_URL=https://achiote.kyanitelabs.tech
